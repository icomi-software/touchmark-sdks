{
  "name": "touchmark",
  "version": "0.2.0",
  "description": "Official TypeScript client for the Touchmark API: email, IP and phone validation.",
  "license": "MIT",
  "author": "Icomi",
  "homepage": "https://api.touchmark.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcin-marciszewski/touchmark-sdks.git",
    "directory": "typescript"
  },
  "keywords": [
    "touchmark",
    "email validation",
    "ip lookup",
    "phone validation",
    "api"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
